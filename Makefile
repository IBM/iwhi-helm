# =============================================================================
# IBM API Connect (apic chart) – convenience targets for the wave-based
# deployment described in charts/apic/README.md.
#
# Override any variable on the command line, e.g.:
#   make wave1 NAMESPACE=apic VALUES_FILE=charts/apic/examples/values-localissuer.yaml
# =============================================================================

CHART_DIR      := charts/apic
NAMESPACE      ?= apic
VALUES_FILE    ?= $(CHART_DIR)/examples/values-localissuer.yaml
POSTCONFIG_TAG ?= 1.0.0

# Release whose catalog sources (charts/apic/catalog-sources/<version>) are
# applied by `make catalog-sources`. AIRGAP=true skips them: apply the
# catalog sources generated by ibm-pak instead (see airgapped-install.md).
APIC_VERSION ?= 12.1.1.3
AIRGAP       ?= false

# Secret values (entitlement key, ...) come from .env, never from the command
# line. See .env.example.
ifneq (,$(wildcard .env))
include .env
export
endif

# Cluster and container-build CLIs. Override for other environments, e.g.:
#   make wave1 OC=kubectl
#   make postconfig-build PODMAN=docker
OC     ?= oc
PODMAN ?= podman

# Extra --set flags appended to every helm invocation, e.g.:
#   make lint EXTRA_ARGS="--set nanogateway.skipGatewayApiCheck=true"
EXTRA_ARGS     ?=

# Internal OpenShift ImageStream reference used by templates/postconfig-job.yaml.
# Override REGISTRY_HOST if you push postConfig.image to an external registry
# instead (see charts/apic/ansible/Dockerfile). Only resolves automatically
# with OC=oc (this route is OpenShift-specific); set it explicitly otherwise.
REGISTRY_HOST  ?= $(shell $(OC) get route default-route -n openshift-image-registry -o jsonpath='{.spec.host}' 2>/dev/null)
POSTCONFIG_IMAGE ?= $(REGISTRY_HOST)/$(NAMESPACE)/apic-postconfig:$(POSTCONFIG_TAG)

.PHONY: help lint template check-tools check-values fill-values \
	platform-prereqs team-prereqs deploy deploy-all info catalogs force-uninstall \
	cert-manager catalog-sources wildcard-routes namespace secrets wait-operators wait-certificates valkey-cluster wait-subsystems \
	wave0 wave1 wave2 wave3 wave4 wave-all \
	postconfig-imagestream postconfig-build postconfig-push postconfig-image \
	postconfig-logs postconfig-status postconfig-rerun \
	uninstall clean

help:
	@echo "Targets:"
	@echo "  check-tools             - verify oc, helm, yq, jq are installed and oc is logged in"
	@echo "  platform-prereqs        - platform team: cert-manager, catalog sources, wildcard routes (if Nano), then wave0"
	@echo "  team-prereqs            - feature team: check-values, namespace, pull secrets"
	@echo "  deploy                  - feature team: team-prereqs + wave1 + wave2 + wave3 (with waits)"
	@echo "  deploy-all              - platform-prereqs + deploy (needs both sets of permissions)"
	@echo "  fill-values             - set global.namespace and global.stackHost in VALUES_FILE (auto-detected from the cluster)"
	@echo "  check-values            - verify VALUES_FILE before deploying"
	@echo "  valkey-cluster          - check the Valkey cluster is really formed and, if the operator failed, form it (included in deploy)"
	@echo "  catalogs                - show each provider-org catalog: gateway, portal, products/APIs, members, settings (via the API)"
	@echo "  info [SHOW_SECRETS=yes] - print URLs, logins and how to read each password (Mailpit included)"
	@echo "  force-uninstall CONFIRM=yes - last-resort teardown of the namespace"
	@echo "  lint                    - helm lint the apic chart"
	@echo "  template WAVE=<0|1|2|3|4|all> - render the chart for a given wave (no cluster changes)"
	@echo "  wave0                   - platform team: cluster-scoped CRDs + ClusterRole/ClusterRoleBinding (oc apply, no Helm)"
	@echo "  wave1                   - feature team: deploy operators (wave 1, namespace-scoped)"
	@echo "  wave2                   - deploy certificates (wave 2)"
	@echo "  wave3                   - deploy subsystems (wave 3)"
	@echo "  wave4                   - deploy post-configuration (wave 4, requires postconfig-image)"
	@echo "  wave-all                - deploy everything in one release (ArgoCD-style, wave=all)"
	@echo "  postconfig-build        - podman build the wave 4 image (linux/amd64)"
	@echo "  postconfig-push         - podman login + push the wave 4 image to the internal registry"
	@echo "  postconfig-logs         - follow the wave 4 Job logs"
	@echo "  postconfig-status       - show the wave 4 Job status"
	@echo "  postconfig-rerun        - delete and redeploy the wave 4 Job (picks up ansible/ changes)"
	@echo "  uninstall                - helm uninstall all apic releases in \$$NAMESPACE"
	@echo ""
	@echo "Variables (override with VAR=value):"
	@echo "  NAMESPACE=$(NAMESPACE)"
	@echo "  VALUES_FILE=$(VALUES_FILE)"
	@echo "  OC=$(OC)"
	@echo "  PODMAN=$(PODMAN)"
	@echo "  POSTCONFIG_IMAGE=$(POSTCONFIG_IMAGE)"

lint:
	helm lint $(CHART_DIR) -f $(VALUES_FILE) --set deployment.wave=1 $(EXTRA_ARGS)

template:
	helm template test $(CHART_DIR) -f $(VALUES_FILE) --set deployment.wave=$(WAVE) $(EXTRA_ARGS)

# =============================================================================
# Prerequisites automation (see charts/apic/README.md "Prerequisites").
#   platform-prereqs : cluster-scoped, platform team (cluster-admin)
#   team-prereqs     : namespace-scoped, feature team
# =============================================================================

KUBECTL_WAIT_SECS ?= 600
# The router runs one pod per node on host ports: its rollout is slow on large clusters.
ROUTER_ROLLOUT_SECS ?= 900
CATALOG_DIR := $(CHART_DIR)/catalog-sources/$(APIC_VERSION)
# Kinds tracked by wait-subsystems (the ones present in the namespace are waited on).
SUBSYSTEM_KINDS := managementcluster.management.apiconnect.ibm.com \
	analyticscluster.analytics.apiconnect.ibm.com \
	gatewaycluster.gateway.apiconnect.ibm.com \
	wmapigatewaycluster.wmapigateway.apiconnect.ibm.com \
	nanogatewaycluster.nanogateway.apiconnect.ibm.com \
	devportalcluster.devportal.apiconnect.ibm.com \
	federatedapimanagementcluster.federatedapimanagement.apiconnect.ibm.com

check-tools:
	@for t in $(OC) helm yq jq; do \
	  command -v $$t >/dev/null 2>&1 || { echo "✗ $$t is not installed." >&2; exit 1; }; \
	done
	@$(OC) whoami >/dev/null 2>&1 || { echo "✗ Not logged in to the cluster: run 'oc login' first." >&2; exit 1; }
	@echo "✓ Tools OK, logged in as $$($(OC) whoami) on $$($(OC) whoami --show-server)"

# --- values.yaml: fill in + verify (edits $(VALUES_FILE) in place with yq) ---

fill-values: check-tools
	@DOMAIN=$$($(OC) get ingresses.config/cluster -o jsonpath='{.spec.domain}' 2>/dev/null); \
	[ -n "$$DOMAIN" ] || { echo "✗ Could not detect the cluster domain (oc get ingresses.config/cluster)." >&2; exit 1; }; \
	yq eval -i '.global.namespace = "$(NAMESPACE)"' $(VALUES_FILE) && \
	yq eval -i ".global.stackHost = \"$(NAMESPACE).$$DOMAIN\"" $(VALUES_FILE) && \
	echo "✓ Set global.namespace=$(NAMESPACE) and global.stackHost=$(NAMESPACE).$$DOMAIN in $(VALUES_FILE) (YAML comments are preserved by yq, formatting may change)."

check-values:
	@FAIL=0; \
	v() { yq eval "$$1" $(VALUES_FILE); }; \
	[ "$$(v '.global.license.accept')" = "true" ] || { echo "✗ global.license.accept is not true." >&2; FAIL=1; }; \
	HOST=$$(v '.global.stackHost'); \
	{ [ -z "$$HOST" ] || [ "$$HOST" = "null" ] || [ "$$HOST" = "apps.example.com" ]; } && { echo "✗ global.stackHost is not set (run 'make fill-values')." >&2; FAIL=1; }; \
	SC=$$(v '.global.storageClass'); \
	$(OC) get storageclass "$$SC" >/dev/null 2>&1 || { echo "✗ StorageClass '$$SC' (global.storageClass) does not exist on the cluster." >&2; FAIL=1; }; \
	if [ "$$(v '.certificates.issuer.mode')" = "existing" ]; then \
	  KIND=$$(v '.certificates.issuer.kind'); NAME=$$(v '.certificates.issuer.name'); \
	  $(OC) get $$KIND $$NAME -n $(NAMESPACE) >/dev/null 2>&1 || { echo "✗ certificates.issuer.mode=existing but $$KIND/$$NAME was not found (create it first, see examples/custom-*issuer.yaml)." >&2; FAIL=1; }; \
	fi; \
	if [ "$$(v '.nanogateway.enabled')" = "true" ] && [ "$$(v '.valkey.enabled')" != "true" ] && [ -z "$$(v '.nanogateway.redis.host // ""')" ]; then \
	  echo "✗ nanogateway.enabled needs valkey.enabled=true or nanogateway.redis.host." >&2; FAIL=1; \
	fi; \
	[ "$$FAIL" = "0" ] || exit 1; \
	echo "✓ check-values OK: $(VALUES_FILE)"

# --- Platform team ---

platform-prereqs: check-tools cert-manager catalog-sources wildcard-routes wave0
	@echo "✓ Platform prerequisites complete."

cert-manager:
	@if $(OC) get crd certificates.cert-manager.io >/dev/null 2>&1; then \
	  echo "✓ cert-manager already installed (certificates.cert-manager.io CRD present), skipping."; \
	else \
	  echo "▶ Installing cert-manager Operator for Red Hat OpenShift"; \
	  $(OC) apply -f hack/cert-manager-subscription.yaml; \
	  if [ -z "$$($(OC) get operatorgroup -n cert-manager-operator -o name 2>/dev/null)" ]; then \
	    $(OC) apply -f hack/cert-manager-operatorgroup.yaml; \
	  else \
	    echo "  an OperatorGroup already exists in cert-manager-operator, leaving it alone."; \
	  fi; \
	  for i in $$(seq 1 30); do \
	    phase=$$($(OC) get csv -n cert-manager-operator -o json 2>/dev/null | jq -r '.items[] | select(.metadata.name | startswith("cert-manager-operator.")) | .status.phase' | head -1); \
	    [ "$$phase" = "Succeeded" ] && { echo "✓ cert-manager CSV Succeeded"; break; }; \
	    echo "  csv phase: $${phase:-<none yet>} ($$i/30)"; sleep 10; \
	    [ "$$i" = "30" ] && { echo "✗ Timed out waiting for the cert-manager CSV." >&2; exit 1; }; \
	  done; \
	fi

catalog-sources:
	@if [ "$(AIRGAP)" = "true" ]; then \
	  echo "⊘ AIRGAP=true: not applying public catalog sources. Apply the ibm-pak generated ones (airgapped-install.md)."; \
	else \
	  echo "▶ Applying catalog sources $(APIC_VERSION)"; \
	  $(OC) apply -f $(CATALOG_DIR)/catalog-sources-apiconnect.yaml -f $(CATALOG_DIR)/catalog-sources-datapower.yaml; \
	  for cs in ibm-apiconnect-catalog opencloud-operators ibm-datapower-operator-catalog; do \
	    for i in $$(seq 1 30); do \
	      st=$$($(OC) get catalogsource $$cs -n openshift-marketplace -o jsonpath='{.status.connectionState.lastObservedState}' 2>/dev/null); \
	      [ "$$st" = "READY" ] && { echo "✓ $$cs READY"; break; }; \
	      sleep 10; \
	      [ "$$i" = "30" ] && { echo "✗ $$cs not READY after 5 minutes (state: $${st:-unknown})." >&2; exit 1; }; \
	    done; \
	  done; \
	fi

# Only needed by the Nano Gateway; skipped otherwise. Cluster-wide change.
wildcard-routes:
	@if [ "$$(yq eval '.nanogateway.enabled' $(VALUES_FILE))" != "true" ]; then \
	  echo "⊘ nanogateway.enabled is not true, skipping wildcard routes."; \
	else \
	  echo "▶ Enabling OpenShift wildcard routes (cluster-wide)"; \
	  $(OC) patch ingresscontroller default -n openshift-ingress-operator --type=merge \
	    -p '{"spec":{"routeAdmission":{"wildcardPolicy":"WildcardsAllowed"}}}'; \
	  $(OC) rollout status deployment/router-default -n openshift-ingress --timeout=$(ROUTER_ROLLOUT_SECS)s; \
	fi

# --- Feature team ---

team-prereqs: check-tools check-values namespace secrets
	@echo "✓ Feature-team prerequisites complete."

namespace:
	$(OC) create namespace $(NAMESPACE) --dry-run=client -o yaml | $(OC) apply -f -

secrets:
	@: $${IBM_ENTITLEMENT_KEY:?Set IBM_ENTITLEMENT_KEY in .env}
	@SECRET=$$(yq eval '.global.imagePullSecret' $(VALUES_FILE)); \
	$(OC) create secret docker-registry "$$SECRET" \
	  --docker-server=cp.icr.io --docker-username=cp \
	  --docker-password="$$IBM_ENTITLEMENT_KEY" -n $(NAMESPACE) \
	  --dry-run=client -o yaml | $(OC) apply -f - && echo "✓ pull secret $$SECRET created."
	@if [ -n "$${ARTIFACT_REPO_HEADER_VALUE:-}" ]; then \
	  cfg() { yq eval-all '. as $$i ireduce ({}; . * $$i)' $(CHART_DIR)/values.yaml $(VALUES_FILE) | yq eval "$$1" -; }; \
	  $(OC) create secret generic "$$(cfg '.wmapigateway.externalJars.auth.secretName')" \
	    --from-literal="$$(cfg '.wmapigateway.externalJars.auth.secretKey')=$$ARTIFACT_REPO_HEADER_VALUE" \
	    -n $(NAMESPACE) --dry-run=client -o yaml | $(OC) apply -f - && echo "✓ artifact repo secret created."; \
	else \
	  echo "⊘ ARTIFACT_REPO_HEADER_VALUE not set, skipping the artifact repo secret."; \
	fi

# --- Waits between waves ---

wait-operators:
	@echo "⏳ Waiting for the operator CSVs to reach Succeeded"
	@for prefix in ibm-apiconnect datapower-operator ibm-common-service-operator operand-deployment-lifecycle-manager; do \
	  for i in $$(seq 1 60); do \
	    phase=$$($(OC) get csv -n $(NAMESPACE) -o json | jq -r --arg p "$$prefix." '.items[] | select(.metadata.name | startswith($$p)) | .status.phase' | head -1); \
	    [ "$$phase" = "Succeeded" ] && { echo "✓ $$prefix Succeeded"; break; }; \
	    echo "  $$prefix: $${phase:-<not found yet>} ($$i/60)"; sleep 10; \
	    [ "$$i" = "60" ] && { echo "✗ Timed out waiting for $$prefix. Check 'oc get csv,subscription,installplan -n $(NAMESPACE)'." >&2; exit 1; }; \
	  done; \
	done

# Wave 2 certificates must be issued before wave 3: the NanoGatewayCluster
# admission webhook rejects the CR if the valkey TLS secret does not exist yet.
# In issuer mode "operator" the leaf certificates stay Pending until wave 3
# (their issuer is created by the operator), so only Valkey's own CA chain is awaited.
wait-certificates:
	@echo "⏳ Waiting for the wave 2 certificates"
	@if [ "$$(yq eval '.valkey.enabled' $(VALUES_FILE))" = "true" ]; then \
	  $(OC) wait certificate/valkey-ca certificate/valkey-tls -n $(NAMESPACE) --for=condition=Ready --timeout=300s || exit 1; \
	fi
	@if [ "$$(yq eval '.certificates.issuer.mode' $(VALUES_FILE))" = "existing" ]; then \
	  $(OC) wait certificate -l app.kubernetes.io/managed-by=Helm -n $(NAMESPACE) --for=condition=Ready --timeout=300s || exit 1; \
	fi
	@echo "✓ Certificates Ready."

wait-subsystems:
	@echo "⏳ Waiting for the subsystems to be Ready (up to $(KUBECTL_WAIT_SECS)s each)"
	@for kind in $(SUBSYSTEM_KINDS); do \
	  if [ -n "$$($(OC) get $$kind -n $(NAMESPACE) -o name 2>/dev/null)" ]; then \
	    echo "  $$kind"; \
	    $(OC) wait $$kind --all -n $(NAMESPACE) --for=condition=Ready --timeout=$(KUBECTL_WAIT_SECS)s \
	      || { echo "✗ $$kind not Ready: oc describe $$kind -n $(NAMESPACE)" >&2; exit 1; }; \
	  fi; \
	done
	@echo "✓ Subsystems Ready."

# --- Valkey cluster formation ---
# The Valkey operator (1.0.0) is expected to bootstrap the cluster, but its
# `valkey-cli --cluster create` runs without a client certificate while the
# servers require one (tls-auth-clients yes): every attempt fails, the pods
# are Running and the ValkeyCluster CR reports 3/3/3, yet the nodes never join
# (cluster_state:fail, 0 slots). This target checks the real cluster state and,
# only if the operator didn't form it within VALKEY_WAIT_SECS, forms it with the
# client certificate: leaders first (--cluster create), then each follower as a
# replica of a leader. Idempotent; the password never appears in the output.
VALKEY_NAME ?= valkey
VALKEY_WAIT_SECS ?= 90

valkey-cluster:
	@if [ "$$(yq eval-all '. as $$i ireduce ({}; . * $$i)' $(CHART_DIR)/values.yaml $(VALUES_FILE) | yq eval '.valkey.enabled' -)" != "true" ]; then echo "⊘ valkey.enabled is not true, skipping."; exit 0; fi; \
	set -e; \
	cfg() { yq eval-all '. as $$i ireduce ({}; . * $$i)' $(CHART_DIR)/values.yaml $(VALUES_FILE) | yq eval "$$1" -; }; \
	L=$$(cfg '.valkey.leaderReplicas'); F=$$(cfg '.valkey.followerReplicas'); \
	SEC=$$(cfg '.valkey.credentialSecret.name'); KEY=$$(cfg '.valkey.credentialSecret.key'); \
	LH=$(VALKEY_NAME)-leader-headless.$(NAMESPACE).svc; FH=$(VALKEY_NAME)-follower-headless.$(NAMESPACE).svc; \
	PW=$$($(OC) get secret "$$SEC" -n $(NAMESPACE) -o jsonpath="{.data.$$KEY}" | base64 -d); \
	OPTS="--tls --cacert /tls/ca.crt --cert /tls/tls.crt --key /tls/tls.key --insecure"; \
	vcli() { pod="$$1"; shift; kind=$${pod%-*}; kind=$${kind##*-}; \
	  $(OC) exec "$$pod" -n $(NAMESPACE) -c "$(VALKEY_NAME)-$$kind" -- sh -c "REDISCLI_AUTH='$$PW' valkey-cli $$OPTS $$*" 2>&1 | tr -d '\r' | sed "s/$$PW/<masked>/g"; }; \
	field() { grep "^$$1:" | cut -d: -f2; }; \
	formed() { [ "$$(vcli $(VALKEY_NAME)-leader-0 cluster info | field cluster_state)" = "ok" ] && [ "$$(vcli $(VALKEY_NAME)-leader-0 cluster info | field cluster_known_nodes)" = "$$((L+F))" ]; }; \
	echo "⏳ Waiting for the $$((L+F)) Valkey pods to be Ready"; \
	for i in $$(seq 0 $$((L-1))); do $(OC) wait pod/$(VALKEY_NAME)-leader-$$i -n $(NAMESPACE) --for=condition=Ready --timeout=300s >/dev/null; done; \
	for i in $$(seq 0 $$((F-1))); do $(OC) wait pod/$(VALKEY_NAME)-follower-$$i -n $(NAMESPACE) --for=condition=Ready --timeout=300s >/dev/null; done; \
	echo "⏳ Checking the cluster (the operator gets $(VALKEY_WAIT_SECS)s to form it by itself)"; \
	t=0; until formed || [ $$t -ge $(VALKEY_WAIT_SECS) ]; do sleep 10; t=$$((t+10)); echo "  not formed yet ($$t/$(VALKEY_WAIT_SECS)s)"; done; \
	if formed; then echo "✓ Valkey cluster already formed: $$((L+F)) nodes, state ok."; exit 0; fi; \
	echo "▶ Cluster not formed by the operator: forming it with the client certificate"; \
	if [ "$$(vcli $(VALKEY_NAME)-leader-0 cluster info | field cluster_known_nodes)" = "1" ]; then \
	  LEADERS=""; for i in $$(seq 0 $$((L-1))); do LEADERS="$$LEADERS $(VALKEY_NAME)-leader-$$i.$$LH:6379"; done; \
	  vcli $(VALKEY_NAME)-leader-0 --cluster create $$LEADERS --cluster-yes | grep -E "OK|ERR|err|Could not" | head -5; \
	fi; \
	for i in $$(seq 0 $$((F-1))); do \
	  if [ "$$(vcli $(VALKEY_NAME)-follower-$$i cluster info | field cluster_known_nodes)" = "1" ]; then \
	    m=$$((i % L)); id=$$(vcli $(VALKEY_NAME)-leader-$$m cluster myid | head -1); \
	    echo "  follower-$$i -> replica of leader-$$m"; \
	    vcli $(VALKEY_NAME)-leader-0 --cluster add-node $(VALKEY_NAME)-follower-$$i.$$FH:6379 $(VALKEY_NAME)-leader-0.$$LH:6379 --cluster-slave --cluster-master-id $$id | grep -E "OK|ERR|err|Could not" | head -3; \
	  fi; \
	done; \
	sleep 5; \
	if formed; then echo "✓ Valkey cluster formed: $$((L+F)) nodes, state ok."; else \
	  echo "✗ Valkey cluster still not healthy:" >&2; for p in $(VALKEY_NAME)-leader-0 $(VALKEY_NAME)-follower-0; do echo "  $$p: $$(vcli $$p cluster info | grep -E 'cluster_state|cluster_known_nodes' | tr '\n' ' ')" >&2; done; exit 1; fi

# --- Orchestration ---

deploy: team-prereqs wave1 wait-operators wave2 wait-certificates wave3 valkey-cluster wait-subsystems
	@echo "✓ Deployment complete. For the post-configuration: make postconfig-build postconfig-push wave4"

deploy-all: platform-prereqs deploy

# Catalogs of the provider org (name, title, gateway and portal services, products/APIs,
# user registries, members) read through the Platform API, as the org owner. Use it to
# verify the catalogs created by the post-configuration without relying on the UI.
catalogs:
	@set -e; \
	ORG=$$(yq eval '.postConfig.providerOrg.name' $(VALUES_FILE)); \
	HOST=$$($(OC) get route management-platform-api -n $(NAMESPACE) -o jsonpath='{.spec.host}'); \
	CRED=$$($(OC) get secret management-cli-cred -n $(NAMESPACE) -o jsonpath='{.data.credential\.json}' | base64 -d); \
	USERS=$$($(OC) get secret porg-lur-users-info -n $(NAMESPACE) -o jsonpath='{.data.porg-lur-users-config\.json}' | base64 -d); \
	TOKEN=$$(jq -n --arg id "$$(jq -r .id <<<"$$CRED")" --arg sec "$$(jq -r .secret <<<"$$CRED")" --arg u "$$(jq -r '.users[0].userId' <<<"$$USERS")" --arg p "$$(jq -r '.users[0].password' <<<"$$USERS")" \
	  '{client_id:$$id,client_secret:$$sec,grant_type:"password",password:$$p,realm:"provider/default-idp-2",username:$$u}' \
	  | curl -sk -X POST "https://$$HOST/api/token" -H 'Content-Type: application/json' -H 'Accept: application/json' --data @- | jq -r .access_token); \
	[ -n "$$TOKEN" ] && [ "$$TOKEN" != "null" ] || { echo "✗ Login to the Platform API failed." >&2; exit 1; }; \
	api() { curl -sk "https://$$HOST$$1" -H "Authorization: Bearer $$TOKEN" -H 'Accept: application/json'; }; \
	names() { jq -r '[.results[]?.name] | join(", ") | if . == "" then "-" else . end'; }; \
	echo "Provider org: $$ORG   (API: https://$$HOST)"; \
	for c in $$(api /api/orgs/$$ORG/catalogs | jq -r '.results[].name' | sort); do \
	  echo ""; echo "== catalog $$c"; \
	  api /api/catalogs/$$ORG/$$c | jq -r '"  title:      \(.title)\n  products:   \(.num_products)   apis: \(.num_apis)"'; \
	  echo "  gateway:    $$(api /api/catalogs/$$ORG/$$c/configured-gateway-services | names)"; \
	  echo "  portal:     $$(api /api/catalogs/$$ORG/$$c/configured-portal-services | names)"; \
	  echo "  tls client profiles: $$(api /api/catalogs/$$ORG/$$c/configured-tls-client-profiles | jq -r '[.results[]? | .name + ":" + .version] | join(", ") | if . == "" then "-" else . end')"; \
	  echo "  registries: $$(api /api/catalogs/$$ORG/$$c/configured-catalog-user-registries | names)"; \
	  echo "  members:    $$(api /api/catalogs/$$ORG/$$c/members | names)"; \
	  echo "  consumer orgs: $$(api /api/catalogs/$$ORG/$$c/consumer-orgs | names)"; \
	  api /api/catalogs/$$ORG/$$c/settings | jq -r '"  settings:   portal.type=\(.portal.type)  spaces=\(.spaces_enabled)  production_mode=\(.production_mode)"'; \
	done

# Access info: URLs, logins and how to read each password.
# SHOW_SECRETS=yes prints the passwords instead of the command that reads them.
SHOW_SECRETS ?= no
MAILPIT_NAMESPACE ?= mailpit

info:
	@route() { h=$$($(OC) get route "$$1" -n "$${2:-$(NAMESPACE)}" -o jsonpath='{.spec.host}' 2>/dev/null); [ -n "$$h" ] && echo "https://$$h" || echo "(not deployed)"; }; \
	pw() { ns="$$1"; name="$$2"; key="$$3"; \
	  if [ "$(SHOW_SECRETS)" = "yes" ]; then \
	    v=$$($(OC) get secret "$$name" -n "$$ns" -o jsonpath="{.data.$$key}" 2>/dev/null | base64 -d); echo "    password: $${v:-(secret $$name not found)}"; \
	  else \
	    echo "    password: $(OC) get secret $$name -n $$ns -o jsonpath='{.data.$$key}' | base64 -d"; \
	  fi; }; \
	echo "== API Connect (namespace $(NAMESPACE)) =="; \
	echo "  Cloud Manager:     $$(route management-admin)"; echo "    user: admin"; pw $(NAMESPACE) management-admin-secret password; \
	echo "  API Manager:       $$(route management-api-manager)"; \
	if [ "$(SHOW_SECRETS)" = "yes" ]; then \
	  $(OC) get secret porg-lur-users-info -n $(NAMESPACE) -o jsonpath='{.data.porg-lur-users-config\.json}' 2>/dev/null | base64 -d | jq -r '.users[] | "    user: \(.userId) (org \(.porgName | if type == "array" then join(",") else . end))  password: \(.password)"'; \
	else \
	  echo "    users:    $(OC) get secret porg-lur-users-info -n $(NAMESPACE) -o jsonpath='{.data.porg-lur-users-config\.json}' | base64 -d | jq ."; \
	fi; \
	echo "  Analytics ingestion: $$(route analytics-ai-endpoint)"; \
	echo "  DataPower API Gateway: $$(route gateway-gateway) (gateway), $$(route gateway-gateway-manager) (manager)"; echo "    admin user: admin"; pw $(NAMESPACE) gateway-admin-secret password; \
	echo "  wM API Gateway UI: $$(route wmapigateway-ui-endpoint)"; echo "    user: Administrator"; pw $(NAMESPACE) wmapigateway-admin-secret password; \
	echo "  Nano Gateway:      $$(route ngw-nanogw)"; \
	echo "  wM Developer Portal: $$(route devportal-devportal-web)"; echo "    user: Administrator"; pw $(NAMESPACE) devportal-admin-secret password; \
	echo "  Federated API Mgmt: $$(route fam-ui-endpoint)"; echo "    user: Administrator  password: manage (fixed webMethods/UMC default)"; \
	echo "== Consumer org owners (one per catalog; Developer Portal / consumer API logins) =="; \
	if [ "$(SHOW_SECRETS)" = "yes" ]; then \
	  $(OC) get secret consumer-org-users-info -n $(NAMESPACE) -o jsonpath='{.data.consumer-org-users-config\.json}' 2>/dev/null | base64 -d | jq -r '.users[]? | "  \(.catalog): user \(.userId) (consumer org \(.consumerOrg))  password: \(.password)"'; \
	else \
	  $(OC) get secret consumer-org-users-info -n $(NAMESPACE) -o jsonpath='{.data.consumer-org-users-config\.json}' 2>/dev/null | base64 -d | jq -r '.users[]? | "  \(.catalog): user \(.userId) (consumer org \(.consumerOrg))"'; \
	  echo "  passwords: $(OC) get secret consumer-org-users-info -n $(NAMESPACE) -o jsonpath='{.data.consumer-org-users-config\.json}' | base64 -d | jq ."; \
	fi; \
	echo "== Mailpit (namespace $(MAILPIT_NAMESPACE)) =="; \
	echo "  UI:   $$(route mailpit-ui $(MAILPIT_NAMESPACE))"; \
	echo "  SMTP: mailpit-smtp.$(MAILPIT_NAMESPACE).svc.cluster.local:1025"; \
	mp=$$($(OC) get secret mailpit-ui-auth -n $(MAILPIT_NAMESPACE) -o jsonpath='{.data.MP_UI_AUTH}' 2>/dev/null | base64 -d); \
	if [ -n "$$mp" ]; then echo "    user: $${mp%%:*}"; \
	  if [ "$(SHOW_SECRETS)" = "yes" ]; then echo "    password: $${mp#*:}"; \
	  else echo "    password: $(OC) get secret mailpit-ui-auth -n $(MAILPIT_NAMESPACE) -o jsonpath='{.data.MP_UI_AUTH}' | base64 -d | cut -d: -f2-"; fi; \
	else echo "    (not deployed)"; fi; \
	[ "$(SHOW_SECRETS)" = "yes" ] || echo "(passwords hidden: re-run with SHOW_SECRETS=yes to print them)"

# Wave 0 — platform team only. Cluster-scoped objects (CRDs, ClusterRole,
# ClusterRoleBinding), applied directly with oc/kubectl, outside Helm.
# Requires cluster-admin-level privileges; the feature team never runs this.
# Safe to re-run (oc apply is idempotent); CRD updates on chart upgrades also
# go through this target — re-run it whenever cluster/crds/*.yaml changes.
# CRDs use --server-side: the valkeyclusters CRD is too large for the
# client-side last-applied annotation (262144-byte limit).
wave0:
	$(OC) apply --server-side --force-conflicts -f $(CHART_DIR)/cluster/crds/nanogateway-crds.yaml
	$(OC) apply --server-side --force-conflicts -f $(CHART_DIR)/cluster/crds/valkey-crds.yaml
	NAMESPACE=$(NAMESPACE) envsubst '$$NAMESPACE' < $(CHART_DIR)/cluster/rbac/nanogateway-operator.yaml | $(OC) apply -f -
	NAMESPACE=$(NAMESPACE) envsubst '$$NAMESPACE' < $(CHART_DIR)/cluster/rbac/valkey-operator.yaml | $(OC) apply -f -

wave1:
	helm upgrade --install apic-operators $(CHART_DIR) \
		-f $(VALUES_FILE) --set deployment.wave=1 -n $(NAMESPACE) $(EXTRA_ARGS)

wave2:
	helm upgrade --install apic-certificates $(CHART_DIR) \
		-f $(VALUES_FILE) --set deployment.wave=2 -n $(NAMESPACE) $(EXTRA_ARGS)

wave3:
	helm upgrade --install apic-subsystems $(CHART_DIR) \
		-f $(VALUES_FILE) --set deployment.wave=3 -n $(NAMESPACE) $(EXTRA_ARGS)

# Wave 4 requires postConfig.image to be set — either bake it into
# VALUES_FILE, or pass it here: make wave4 POSTCONFIG_IMAGE=...
wave4:
	helm upgrade --install apic-postconfig $(CHART_DIR) \
		-f $(VALUES_FILE) --set deployment.wave=4 \
		--set postConfig.enabled=true \
		--set postConfig.image=$(POSTCONFIG_IMAGE) \
		-n $(NAMESPACE) $(EXTRA_ARGS)

wave-all:
	helm upgrade --install apic $(CHART_DIR) \
		-f $(VALUES_FILE) --set deployment.wave=all -n $(NAMESPACE) $(EXTRA_ARGS)

# --- Wave 4 image lifecycle ---------------------------------------------

postconfig-build:
	cd $(CHART_DIR)/ansible && $(PODMAN) build --platform linux/amd64 -t $(POSTCONFIG_IMAGE) .

# oc/kubectl `create token` both work for the ServiceAccount login below.
# Extra flag for podman login/push, e.g. PODMAN_TLS_FLAG=--tls-verify=false
# when the registry route uses a self-signed certificate.
PODMAN_TLS_FLAG ?=

postconfig-push:
	$(OC) whoami -t | $(PODMAN) login -u unused --password-stdin $(PODMAN_TLS_FLAG) $(REGISTRY_HOST)
	$(PODMAN) push $(PODMAN_TLS_FLAG) $(POSTCONFIG_IMAGE)

# --- Wave 4 Job lifecycle -----------------------------------------------

postconfig-logs:
	$(OC) logs -f job/apic-postconfig -n $(NAMESPACE) -c ansible-playbook

postconfig-status:
	$(OC) get job apic-postconfig -n $(NAMESPACE)
	$(OC) get pod -n $(NAMESPACE) -l app.kubernetes.io/name=apic-postconfig

# Jobs are immutable once created: delete before re-running (e.g. after
# editing ansible/ roles, which only need a ConfigMap regen via `helm
# upgrade`, not a new image).
postconfig-rerun:
	$(OC) delete job apic-postconfig -n $(NAMESPACE) --ignore-not-found
	$(MAKE) wave4

# --- Cleanup --------------------------------------------------------------

uninstall:
	-helm uninstall apic-postconfig -n $(NAMESPACE)
	-helm uninstall apic-subsystems -n $(NAMESPACE)
	-helm uninstall apic-certificates -n $(NAMESPACE)
	-helm uninstall apic-operators -n $(NAMESPACE)

# Last resort when `uninstall` cannot finish (namespace stuck Terminating on a
# CR finalizer whose operator is already gone). Webhook configs are removed
# first: once namespace deletion starts the operator pods backing them go
# away, and a later patch/delete on a CR then hangs on the dead webhook.
# CRDs, cluster RBAC from wave0, cert-manager and catalog sources are left alone.
force-uninstall:
	@[ "$(CONFIRM)" = "yes" ] || { echo "✗ This force-deletes namespace '$(NAMESPACE)'. Re-run with CONFIRM=yes." >&2; exit 1; }
	@for kind in validatingwebhookconfiguration mutatingwebhookconfiguration; do \
	  $(OC) get $$kind -o json 2>/dev/null | jq -r --arg ns "$(NAMESPACE)" \
	    '.items[] | select(any(.webhooks[]?; .clientConfig.service.namespace == $$ns)) | .metadata.name' | sort -u | \
	  while read -r name; do [ -n "$$name" ] && $(OC) delete $$kind "$$name" --ignore-not-found; done; \
	done
	@$(OC) delete namespace $(NAMESPACE) --wait=false --ignore-not-found
	@for i in $$(seq 1 30); do \
	  $(OC) get namespace $(NAMESPACE) >/dev/null 2>&1 || { echo "✓ Namespace $(NAMESPACE) deleted."; exit 0; }; \
	  for gvk in $$($(OC) get crd -o json | jq -r '.items[] | select(.spec.group | test("ibm\\.com$$|valkey")) | "\(.spec.names.plural).\(.spec.group)"'); do \
	    for name in $$($(OC) get "$$gvk" -n $(NAMESPACE) -o name 2>/dev/null); do \
	      echo "  clearing finalizers on $$name"; \
	      $(OC) patch "$$name" -n $(NAMESPACE) --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true; \
	    done; \
	  done; sleep 10; \
	done; echo "⚠ Namespace $(NAMESPACE) still terminating after 5 minutes." >&2; exit 1
