# Copy to .env and fill in. .env is git-ignored -- never commit real
# credentials. Used by `make secrets` (and `make deploy`, which calls it).
#
# Only secret values live here -- namespace, values file, etc. are Makefile
# variables (see `make help`), not duplicated here.

# IBM entitlement key (https://myibm.ibm.com/products-services/containerlibrary).
# Required: creates the pull secret named by global.imagePullSecret.
IBM_ENTITLEMENT_KEY=

# Only needed if wmapigateway.externalJars.auth.enabled is true. Full HTTP
# header value sent to the artifact repo, scheme included, e.g.
# "Basic <base64>" or "Bearer <token>". Leave empty to skip the secret.
ARTIFACT_REPO_HEADER_VALUE=

# Mailpit UI credentials (informational, written by the Mailpit deployment).
MAILPIT_URL=
MAILPIT_USER=
MAILPIT_PASSWORD=
